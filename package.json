{
  "name": "kingdom-mmo",
  "version": "0.1.0",
  "private": true,
  "description": "Server-authoritative single-kingdom 4X MMO monorepo",
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "pnpm --recursive --if-present build",
    "dev": "pnpm --parallel --filter @kingdom/server --filter @kingdom/admin-web dev",
    "setup:local": "tsx scripts/local-setup.ts",
    "local:up": "docker compose up -d postgres redis minio",
    "local:observability": "docker compose --profile observability up -d",
    "local:tools": "docker compose --profile tools up -d",
    "local:down": "docker compose --profile observability --profile tools down",
    "db:migrate": "pnpm --filter @kingdom/server db:migrate",
    "db:seed": "pnpm --filter @kingdom/server db:seed",
    "db:reset": "pnpm --filter @kingdom/server db:reset",
    "lint": "eslint .",
    "typecheck": "pnpm --recursive --if-present typecheck",
    "test": "pnpm --recursive --if-present test",
    "test:coverage": "pnpm --recursive --if-present test:coverage",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "contracts:check": "pnpm --filter @kingdom/contracts check",
    "docs:import-blueprint": "node scripts/import-blueprint.mjs",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm contracts:check && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/node": "^24.1.0",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0"
  }
}
