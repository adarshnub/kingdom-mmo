{
  "name": "@kingdom/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json && node ../../scripts/copy-server-assets.mjs",
    "predev": "pnpm --filter @kingdom/contracts build && pnpm --filter @kingdom/domain build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "concurrently -n api,realtime,worker -c blue,magenta,yellow \"tsx watch src/main-api.ts\" \"tsx watch src/main-realtime.ts\" \"tsx watch src/main-worker.ts\"",
    "start:api": "node dist/src/main-api.js",
    "start:realtime": "node dist/src/main-realtime.js",
    "start:worker": "node dist/src/main-worker.js",
    "db:migrate": "tsx src/scripts/migrate.ts",
    "db:seed": "tsx src/scripts/seed.ts",
    "db:reset": "tsx src/scripts/reset.ts",
    "smoke:realtime": "tsx src/scripts/realtime-smoke.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@kingdom/contracts": "workspace:*",
    "@kingdom/domain": "workspace:*",
    "@nestjs/common": "^12.0.3",
    "@nestjs/core": "^12.0.3",
    "@nestjs/platform-fastify": "^12.0.3",
    "dotenv": "^18.0.1",
    "fastify": "^5.12.5",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "kysely": "^0.29.6",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "uuid": "^14.0.2",
    "ws": "^8.21.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^3.2.4",
    "concurrently": "^9.2.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
